# Copy to server/.env and fill in. Never commit the real .env file.

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/hisaab

# Secret used to sign login tokens. Use a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on
PORT=4000

# development | production | test
NODE_ENV=development

# Only needed in development when the React dev server runs on a different port
CLIENT_ORIGIN=http://localhost:5173

# How often (minutes) the local recurring-expense job runs
RECURRING_INTERVAL_MINUTES=10

# Optional: enables /api/cron/recurring for an external scheduler (Authorization: Bearer <secret>)
CRON_SECRET=replace-with-another-long-random-string

# Optional: Razorpay online payments (Dashboard → Account & Settings → API Keys).
# Use test-mode keys (rzp_test_...) for the demo. Leave empty to hide "Pay online".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: secret you set when creating the webhook in Razorpay
# (URL https://<your-app>/api/payments/webhook, events payment.captured and order.paid).
RAZORPAY_WEBHOOK_SECRET=
